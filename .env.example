# Variables públicas que Vite puede incluir en el navegador.
# No agregues SUPABASE_SECRET_KEY, service_role ni secretos OAuth aquí.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Opcional. Debe coincidir exactamente con una Redirect URL permitida en Supabase Auth.
# En desarrollo se usa http://localhost:5173/auth/callback si se deja vacío.
VITE_AUTH_REDIRECT_URL=

# Clave PÚBLICA VAPID. La clave privada existe solo en secretos de Edge Functions.
VITE_VAPID_PUBLIC_KEY=your-public-vapid-key
